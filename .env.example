# Copy this file to .env and fill in your values.

# ── Required ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── GitHub (optional) ─────────────────────────────────────────────────────────
# Personal access token for PR reviews (fine-grained, read-only "Pull requests").
# Without it only public repos work and the unauthenticated limit applies (60 req/hr).
GITHUB_TOKEN=ghp_...

# ── Model ─────────────────────────────────────────────────────────────────────
# Default: claude-haiku-4-5-20251001. Use claude-sonnet-4-6 for deeper reviews (slower, ~5x cost).
# REVIEW_MODEL=claude-haiku-4-5-20251001

# Max tokens in the review response. Raise if reviews of big snippets get cut short.
# REVIEW_MAX_TOKENS=2048

# Anthropic request timeout (seconds) and retries for 429/5xx/connection errors.
# ANTHROPIC_TIMEOUT=60
# ANTHROPIC_MAX_RETRIES=2

# ── Limits ────────────────────────────────────────────────────────────────────
# Max snippet length in characters (≈ 1000 lines). Longer requests get HTTP 400.
# MAX_CODE_CHARS=50000

# Max diff size per PR file before it is truncated (on a line boundary) with a notice.
# MAX_PATCH_CHARS=20000

# Max reviewable files per PR, and how many are reviewed in parallel.
# MAX_PR_FILES=20
# REVIEW_CONCURRENCY=4

# Pages of 100 changed files to fetch from GitHub per PR.
# GITHUB_MAX_PAGES=5

# Max length of the optional context string.
# MAX_CONTEXT_LEN=500

# ── Deployment ────────────────────────────────────────────────────────────────
# Shared secret. When set, /review and /review-pr require an X-API-Key header
# (the UI shows a key field automatically). Set this before exposing the app
# beyond localhost.
# API_KEY=

# Comma-separated origins allowed to call the API from another origin.
# Not needed when the UI is served by this app (same origin).
# CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000
