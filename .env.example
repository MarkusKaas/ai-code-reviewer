# Copy this file to .env and fill in your values.
# Required
ANTHROPIC_API_KEY=sk-ant-...

# Optional: GitHub personal access token for PR reviews (fine-grained, read-only)
# Without this, only public repos work and unauthenticated rate limits apply (60 req/hr)
GITHUB_TOKEN=ghp_...

# Model to use for reviews (default: claude-haiku-4-5-20251001)
# Swap to claude-sonnet-4-6 for deeper, more thorough reviews (higher cost)
# REVIEW_MODEL=claude-haiku-4-5-20251001

# Maximum tokens in the review response (default: 2048)
# Increase if reviews are being cut short for very large snippets
# REVIEW_MAX_TOKENS=2048

# Maximum code snippet length in characters (default: 50000 ≈ ~1000 lines)
# Requests over this limit are rejected with HTTP 400
# MAX_CODE_CHARS=50000

# Maximum diff patch size per file before truncation (default: 20000 chars)
# Larger patches are truncated with a notice so the reviewer knows
# MAX_PATCH_CHARS=20000

# Maximum number of files to review in a single PR (default: 20)
# MAX_PR_FILES=20

# Maximum length of the optional context string (default: 500 chars)
# MAX_CONTEXT_LEN=500
